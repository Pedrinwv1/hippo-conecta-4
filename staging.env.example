# Configuração LOCAL de validação do HIPPO CONECTA — somente STAGING.
# Copie para .env (não versionar) e substitua apenas a senha do staging.
NODE_ENV=development
PORT=3001
REQUIRE_POSTGRES=true
DATABASE_URL=postgresql://postgres.msnhqsopecmcccdabmcs:SENHA_DO_STAGING@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
PGSSL=true
PG_POOL_MAX=3
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_64_CARACTERES
# Armazenamento local isolado para não gravar em buckets de produção.
UPLOAD_DIR=./.staging-uploads
# URL explícita do projeto de STAGING para impedir fallback ao projeto de produção.
SUPABASE_URL=https://msnhqsopecmcccdabmcs.supabase.co
# Não configurar SUPABASE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY ou R2_* nesta primeira rodada.
# Cadastro por e-mail exige configurar Resend de teste:
RESEND_API_KEY=
EMAIL_FROM=
